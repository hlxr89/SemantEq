import Mathlib

-- ===== unified context (both sides' local defs, merged) =====
-- empty

-- ===== assumed statement (antecedent) =====
theorem problem_statement_assumed :
  ∃ p q : ℕ, p > 0 ∧ q > 0 ∧ 
  (p : ℚ) / q = Finset.sum (Finset.range 1319) (fun k => ((-1 : ℚ)^k * (1 : ℚ) / (k + 1 : ℚ))) ∧
  1979 ∣ p := by
  sorry

-- ===== goal statement, PROVED from the antecedent =====
theorem imo1979_p1 (p q : ℤ) (hp : 0 < p) (hq : 0 < q)
    (h : (p : ℚ) / q = ∑ i ∈ Finset.range 1319, (-1 : ℚ)^i / (i + 1)) :
    1979 ∣ p := by
  let N : ℕ := 
  let D : ℕ := 
  have hsum : (N : ℚ) / D =
      ∑ i ∈ Finset.range 1319, (-1 : ℚ)^i / (i + 1) := by
    norm_num [N, D, Finset.sum_range_succ]
  have heq : (p : ℚ) / q = (N : ℚ) / D := h.trans hsum.symm
  have hq0 : (q : ℚ) ≠ 0 := by exact_mod_cast (ne_of_gt hq)
  have hD0 : (D : ℚ) ≠ 0 := by norm_num [D]
  have hcrossQ : (p : ℚ) * (D : ℚ) = (N : ℚ) * (q : ℚ) :=
    (div_eq_div_iff hq0 hD0).mp heq
  have hcrossZ : p * (D : ℤ) = (N : ℤ) * q := by
    exact_mod_cast hcrossQ
  have hdvdN : (1979 : ℤ) ∣ (N : ℤ) := by norm_num [N]
  have hdvdProd : (1979 : ℤ) ∣ (D : ℤ) * p := by
    rw [mul_comm, hcrossZ]
    exact dvd_mul_of_dvd_left hdvdN q
  have hprime : Prime (1979 : ℤ) := by
    rw [Int.prime_iff_natAbs_prime]
    norm_num
  rcases hprime.dvd_or_dvd hdvdProd with hdivD | hdivp
  · have hnot : ¬(1979 : ℤ) ∣ (D : ℤ) := by norm_num [D]
    exact (hnot hdivD).elim
  · exact hdivp
