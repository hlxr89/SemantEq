import Mathlib

-- ===== unified context (both sides' local defs, merged) =====
-- empty

-- ===== assumed statement (antecedent) =====
theorem imo1979_p1_assumed (p q : ℤ) (hp : 0 < p) (hq : 0 < q)
    (h : (p : ℚ) / q = ∑ i ∈ Finset.range 1319, (-1 : ℚ)^i / (i + 1)) :
    1979 ∣ p := by
  sorry

-- ===== goal statement, PROVED from the antecedent =====
theorem problem_statement :
  ∃ p q : ℕ, p > 0 ∧ q > 0 ∧ 
  (p : ℚ) / q = Finset.sum (Finset.range 1319) (fun k => ((-1 : ℚ)^k * (1 : ℚ) / (k + 1 : ℚ))) ∧
  1979 ∣ p := by
  let N : ℕ := 
  let D : ℕ := 
  have hN : 0 < N := by norm_num [N]
  have hD : 0 < D := by norm_num [D]
  have hsum : (N : ℚ) / D =
      Finset.sum (Finset.range 1319)
        (fun k => ((-1 : ℚ)^k * (1 : ℚ) / (k + 1 : ℚ))) := by
    norm_num [N, D, Finset.sum_range_succ]
  have href : ((N : ℤ) : ℚ) / (D : ℤ) =
      ∑ i ∈ Finset.range 1319, (-1 : ℚ)^i / (i + 1) := by
    simpa using hsum
  have hdvdZ : (1979 : ℤ) ∣ (N : ℤ) :=
    imo1979_p1_assumed (N : ℤ) (D : ℤ) (by exact_mod_cast hN)
      (by exact_mod_cast hD) href
  have hdvdN : 1979 ∣ N := by exact_mod_cast hdvdZ
  exact ⟨N, D, hN, hD, hsum, hdvdN⟩
