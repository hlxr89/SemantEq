theorem dummy {R : Type*} [CommRing R] (H : IsDomain R) (H1 : ∀ a b : R, a ≠ 0 → b ≠ 0 → ∃ d x y, d ∣ a ∧ d ∣ b ∧ x * a + y * b = d) (H2 : ∀ a : R, a ≠ 0 → ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → IsUnit (a * a^n)) : IsPrincipalIdealRing R := by
  letI : IsDomain R := H
  have hunit : ∀ a : R, a ≠ 0 → IsUnit a := by
    intro a ha
    obtain ⟨n₀, hn₀⟩ := H2 a ha
    exact ((Commute.all a (a ^ n₀)).isUnit_mul_iff.mp (hn₀ n₀ le_rfl)).1
  have hfield : IsField R := by
    exact {
      exists_pair_ne := exists_pair_ne R
      mul_comm := fun a b => mul_comm a b
      mul_inv_cancel := fun ha => (hunit _ ha).exists_right_inv
    }
  letI := hfield.toField
  infer_instance
