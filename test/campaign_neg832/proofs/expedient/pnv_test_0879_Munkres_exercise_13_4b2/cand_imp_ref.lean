import Mathlib

open Filter Set TopologicalSpace
open scoped Topology

-- ===== unified context (both sides' local defs, merged) =====
def is_topology (X : Type*) (T : Set (Set X)) :=
  univ ∈ T ∧
  (∀ s t, s ∈ T → t ∈ T → s ∩ t ∈ T) ∧
  (∀s, (∀t ∈ s, t ∈ T) → sUnion s ∈ T)

-- ===== assumed statement (antecedent) =====
theorem dummy_assumed {ι : Type*} {X : Type*} (T : ι → TopologicalSpace X) : ∃! (m : TopologicalSpace X), ∀ (i : ι), T i ≤ m := by
  sorry

-- ===== goal statement, PROVED from the antecedent =====
theorem exercise_13_4b2 (X I : Type*) (T : I → Set (Set X)) (h : ∀ i, is_topology X (T i)) :
  ∃! T', is_topology X T' ∧ (∀ i, T' ⊆ T i) ∧
  ∀ T'', is_topology X T'' → (∀ i, T'' ⊆ T i) → T'' ⊆ T' := by
  let T' : Set (Set X) := {s | ∀ i, s ∈ T i}
  have hT' : is_topology X T' := by
    refine ⟨?_, ?_, ?_⟩
    · intro i
      exact (h i).1
    · intro s t hs ht i
      exact (h i).2.1 s t (hs i) (ht i)
    · intro s hs i
      exact (h i).2.2 s (by
        intro t ht
        exact hs t ht i)
  have hsub : ∀ i, T' ⊆ T i := by
    intro i s hs
    exact hs i
  have hmax : ∀ T'', is_topology X T'' → (∀ i, T'' ⊆ T i) → T'' ⊆ T' := by
    intro T'' _ hT'' s hs i
    exact hT'' i hs
  refine ⟨T', ⟨hT', hsub, hmax⟩, ?_⟩
  intro T'' hT''
  apply Set.Subset.antisymm
  · exact hmax T'' hT''.1 hT''.2.1
  · exact hT''.2.2 T' hT' hsub
