import Mathlib

open Filter Set TopologicalSpace
open scoped Topology

-- ===== unified context (both sides' local defs, merged) =====
def is_topology (X : Type*) (T : Set (Set X)) :=
  univ ∈ T ∧
  (∀ s t, s ∈ T → t ∈ T → s ∩ t ∈ T) ∧
  (∀s, (∀t ∈ s, t ∈ T) → sUnion s ∈ T)

-- ===== assumed statement (antecedent) =====
theorem dummy_assumed {X : Type*} (Tα : ι → TopologicalSpace X) : ∃ (T : TopologicalSpace X), ∀ (α : ι), Tα α ≤ T := by
  sorry

-- ===== goal statement, PROVED from the antecedent =====
theorem exercise_13_4b2 (X I : Type*) (T : I → Set (Set X)) (h : ∀ i, is_topology X (T i)) :
  ∃! T', is_topology X T' ∧ (∀ i, T' ⊆ T i) ∧
  ∀ T'', is_topology X T'' → (∀ i, T'' ⊆ T i) → T'' ⊆ T' := by
  let T' : Set (Set X) := {s | ∀ i, s ∈ T i}
  have htop : is_topology X T' := by
    refine ⟨?_, ?_, ?_⟩
    · exact fun i => (h i).1
    · intro s t hs ht i
      exact (h i).2.1 s t (hs i) (ht i)
    · intro s hs i
      exact (h i).2.2 s fun t ht => hs t ht i
  have hprop : is_topology X T' ∧ (∀ i, T' ⊆ T i) ∧
      ∀ T'', is_topology X T'' → (∀ i, T'' ⊆ T i) → T'' ⊆ T' := by
    refine ⟨htop, fun i s hs => hs i, ?_⟩
    intro T'' _ hsub s hs i
    exact hsub i hs
  refine ⟨T', hprop, ?_⟩
  intro S hS
  apply Set.Subset.antisymm
  · exact hprop.2.2 S hS.1 hS.2.1
  · exact hS.2.2 T' hprop.1 hprop.2.1
