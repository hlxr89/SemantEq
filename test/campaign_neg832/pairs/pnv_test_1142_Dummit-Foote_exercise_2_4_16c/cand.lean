import Mathlib

open Fintype Subgroup Set Polynomial Ideal
open scoped BigOperators

theorem dummy {G : Type*} [Group G] {x : G} {n : ℕ} (hx : x ^ n = 1) (hn : 1 ≤ n) (H : Subgroup G) : (H ≤ Subgroup.zpowers x ∧ H ≠ ⊥ ∧ ∀ K : Subgroup G, H < K → K = ⊤) ↔ ∃ p : ℕ, Nat.Prime p ∧ p ∣ n ∧ H = Subgroup.zpowers (x ^ (n / p)) := sorry
